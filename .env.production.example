API_IMAGE=ghcr.io/your-user/financial-management-api:latest
PRODUCTION_DATABASE_CONNECTION=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=FinancialDB;User ID=replace-me;Password=replace-me;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=FinApp
JWT_AUDIENCE=FinAppUsers
JWT_EXPIRY_MINUTES=60

FRONTEND_URL=https://app.minhasfinancas.example
BACKEND_URL=https://api.minhasfinancas.example
ALLOWED_HOSTS=api.minhasfinancas.example

SMTP_HOST=smtp.example-provider.com
SMTP_PORT=587
SMTP_FROM_ADDRESS=no-reply@minhasfinancas.example
SMTP_FROM_NAME=Minhas Finanças
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-api-key-or-app-password
SMTP_ENABLE_SSL=true
