SQL_SERVER_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# Email local: o Mailpit captura as mensagens em http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_ADDRESS=no-reply@minhasfinancas.local
SMTP_FROM_NAME=Minhas Finanças
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=false

# Opcional: somente para criar um administrador local de forma explícita.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Exemplo fictício de SMTP externo. Substitua os valores acima no arquivo .env local:
# SMTP_HOST=smtp.example-provider.com
# SMTP_PORT=587
# SMTP_FROM_ADDRESS=no-reply@minhasfinancas.example
# SMTP_FROM_NAME=Minhas Finanças
# SMTP_USERNAME=portfolio-user@example.com
# SMTP_PASSWORD=replace-with-provider-api-key-or-app-password
# SMTP_ENABLE_SSL=true
